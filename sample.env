# ─────────────────────────────────────────────────────────────────────────────
# figma-to-markdown — environment configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Figma Personal Access Token  (Settings → Account → Personal access tokens)
# OR an OAuth 2.0 Bearer token (set FIGMA_TOKEN_TYPE=oauth in that case)
FIGMA_ACCESS_TOKEN=FIGMA_API_KEY

# ── Server ────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development           # development | production | test

# Allowed CORS origin. Use '*' for open access or a specific origin in prod.
CORS_ORIGIN=*

# ── Figma API ─────────────────────────────────────────────────────────────────

FIGMA_TOKEN_TYPE=personal      # personal | oauth
FIGMA_TIMEOUT_MS=30000         # HTTP request timeout in ms

# ── Caching ───────────────────────────────────────────────────────────────────

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300          # How long to cache Figma API responses (seconds)
CACHE_MAX_ITEMS=100            # Maximum number of cached entries (LRU eviction)

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=debug                # error | warn | info | debug
LOG_FORMAT=pretty              # pretty (dev) | json (production/log aggregators)

# ── Markdown output ───────────────────────────────────────────────────────────

MD_INCLUDE_NODE_IDS=true       # Annotate headings with Figma node IDs
MD_INCLUDE_THUMBNAILS=true     # Embed thumbnail URLs as Markdown images
MD_MAX_DEPTH=10                # Max frame nesting depth to render
MD_CODE_LANG=json              # Language for code fence blocks

# ── Component Name Mapping ─────────────────────────────────────────────────────

COMPONENT_MAPPING_ENABLED=true  # Enable component name mapping (true | false)
COMPONENT_MAPPING_FILE=ConversionMapForSynapse.json  # Path to mapping JSON file